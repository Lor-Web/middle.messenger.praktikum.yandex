<main class="profile">
  <header class="profile__header">
    <h3 class="profile__header-title">Профиль</h3>
  </header>

  <section class="profile-wrapper">
    <div class="profile__data">
      <img
        class="avatar avatar_large"
        src="/1fb255dfa8704817151167d37cab665f.png"
      />

      <form class="profile__data-form">
        {{> input placeholder="Имя" value=user.name }}
        {{> input placeholder="Почта" value=user.email }}
        {{> input placeholder="Телефон" value=user.tel }}
      </form>

      {{> button label="Сохранить" }}
    </div>
  </section>
</main>