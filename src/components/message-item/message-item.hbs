<div class="message-item {{#if (authorMessage senderId)}}message-item_author{{/if}}">
  <div class="message-item__value message-item__value_{{message.type}}">
    {{#if (messageTypeText message.type)}}
      <p class="message-item__value-text">{{message.value}}</p>
      
      {{else}}
        <img
          class="message-item__value-image"
          src="{{message.value}}"
        />  
    {{/if}}
  </div>

  <p class="message-item__date">
    {{formatDate timestamp}}
  </p>

  {{#if reading}}
    <div class="message-item__read-status">
      {{> icon name="check-double" }}
    </div>
  {{/if}}
</div>