{{#if link}}
  <a 
    class="
      button 
      {{#if widthFull}}button_width_full{{/if}} 
      {{#if icon}}button_icon{{/if}}
      {{#if transparent}}button_transparent{{/if}}
      " 
    href="{{href}}"
    {{#if disabled}}disabled{{/if}}
  >
  {{#if icon}}
    {{> @partial-block }}
  {{/if}}
  
  {{label}}
  </a>

  {{else}}
  <button 
    class="
      button 
      {{#if widthFull}}button_width_full{{/if}} 
      {{#if icon}}button_icon{{/if}}
      {{#if transparent}}button_transparent{{/if}}
      " 
    type="{{#if type}}{{type}}{{else}}button{{/if}}"
    {{#if disabled}}disabled{{/if}}
  >
  {{#if icon}}
    {{> @partial-block }}
  {{/if}}
  
  {{label}}
  </button>    
{{/if}}