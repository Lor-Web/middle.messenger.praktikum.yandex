{
  "name": "middle-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.15.1",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && npm run preview",
    "prebuild": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:styles": "stylelint **/*.scss",
    "lint:styles:fix": "stylelint **/*.scss --fix",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
