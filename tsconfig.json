{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "declaration": false,
    "module": "ESNext",
    "strictNullChecks": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@core": ["./src/core/*"],

      "@pages": ["./src/pages/*"],
      "@widgets": ["./src/widgets/*"],
      "@features": ["./src/features/*"],

      "@shared/constants": ["./src/shared/constants/*"],
      "@shared/helpers": ["./src/shared/helpers/*"],
      "@shared/lib": ["./src/shared/lib/*"],
      "@shared/models": ["./src/shared/models/*"],
      "@shared/ui": ["./src/shared/ui/*"]
    }
  }
}
